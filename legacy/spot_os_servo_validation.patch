+"""Test the actual callback without importing ROS or real hardware drivers."""
+import ast
+import json
+import math
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+SOURCE = Path(__file__).resolve().parents[1] / 'sth_conv_py' / 'servo_driver.py'
+
+class ServoFrameTests(unittest.TestCase):
+    def setUp(self):
+        self.writes=[]
+        self.warnings=[]
+        outer=self
+        class Servo:
+            def __init__(self,i):self.i=i
+            @property
+            def angle(self):return None
+            @angle.setter
+            def angle(self,value):outer.writes.append((self.i,value))
+        ns={'Node':object,'json':json,'math':math,'kit':SimpleNamespace(servo=[Servo(i) for i in range(16)])}
+        tree=ast.parse(SOURCE.read_text(encoding='utf-8-sig'))
+        cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='ServoDrver')
+        exec(compile(ast.Module(body=[cls],type_ignores=[]),str(SOURCE),'exec'),ns)
+        self.driver=object.__new__(ns['ServoDrver'])
+        self.driver.get_logger=lambda:SimpleNamespace(info=lambda _:None,warning=self.warnings.append)
+
+    def send(self,payload):
+        self.driver.servo_callback(SimpleNamespace(data=json.dumps(payload)))
+
+    def test_valid_complete_frame_preserves_channels_and_integer_angles(self):
+        self.send({f'S{i}':90.9 for i in range(1,17)})
+        self.assertEqual(self.writes,[(i,90) for i in range(16)])
+        self.assertFalse(self.warnings)
+
+    def test_missing_last_channel_does_not_write_any_channel(self):
+        self.send({f'S{i}':90 for i in range(1,16)})
+        self.assertEqual(self.writes,[])
+        self.assertEqual(len(self.warnings),1)
+
+    def test_bad_last_angle_does_not_partially_move_robot(self):
+        for value in (-1,181,180.9,float('nan'),float('inf'),None,True,'bad',{}):
+            with self.subTest(value=value):
+                self.writes.clear();self.warnings.clear()
+                payload={f'S{i}':90 for i in range(1,17)};payload['S16']=value
+                self.send(payload)
+                self.assertEqual(self.writes,[])
+                self.assertEqual(len(self.warnings),1)
+
+    def test_malformed_json_and_wrong_root_are_rejected(self):
+        for raw in ('{', '[]', 'null'):
+            with self.subTest(raw=raw):
+                self.driver.servo_callback(SimpleNamespace(data=raw))
+                self.assertEqual(self.writes,[])
+        self.assertEqual(len(self.warnings),3)
+
+if __name__=='__main__':unittest.main()
